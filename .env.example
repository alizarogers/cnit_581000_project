# Copy to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=

# Model and generation settings
CLAUDE_MODEL=claude-sonnet-5-5
MAX_TOKENS=1024
MAX_HISTORY_TURNS=10

# Where each question/answer pair is logged (useful for evaluation)
LOG_DB_PATH=./logs/chat_log.db

CORS_ORIGIN=*

# Pun pipeline: "full" = spaCy + BERT + WordNet evidence goes to Claude (Stages 1-3);
# "llm_only" = Claude alone
PIPELINE_MODE=full
BERT_MODEL=bert-base-uncased
SPACY_MODEL=en_core_web_sm
# Stage 1-2 call is "Pun" when the double-sense score reaches this value
PUN_THRESHOLD=0.30
